---
import { avisos, indexavel, site } from "../config/site";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!indexavel && <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
    <footer>
      <p>{avisos.publico}</p>
    </footer>
  </body>
</html>
